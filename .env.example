# Cadena de conexión a Supabase Postgres. Usa el session-mode pooler de
# Supavisor (Project -> Connect -> ORMs/URI, el que usa puerto 5432 y
# aws-0-<region>.pooler.supabase.com como host), el recomendado para un
# backend persistente (no serverless). NO el transaction-mode pooler (6543):
# ese no soporta prepared statements y falla con "prepared statement already
# exists" bajo carga. Tampoco la "Direct connection" (db.xxxx.supabase.co):
# esa es IPv6-only salvo que pagues el addon de IPv4.
# Ejemplo: DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-xx-region-1.pooler.supabase.com:5432/postgres
# Si se deja vacío, la app usa un SQLite local (./dev.db) para desarrollo.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Dominios permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

ENVIRONMENT=development

# Supabase, usado para Auth del panel de administración.
# URL base del proyecto (Project Settings -> API -> Project URL, SIN /rest/v1/).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=tu-anon-public-key
# SENSIBLE: acceso total a la base de datos, bypassa RLS. Solo en el backend, nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
